{
  "name": "factory-ui",
  "version": "1.0.0",
  "description": "Oracle JET web UI for OBDX Development Factory",
  "dependencies": {
    "@oracle/oraclejet": "~21.0.0",
    "@oracle/oraclejet-core-pack": "~21.0.0"
  },
  "devDependencies": {
    "fs-extra": "^8.1.0",
    "glob": "10.4.5",
    "underscore": "^1.10.2",
    "@oracle/ojet-cli": "~21.0.1",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "0.21.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "private": true,
  "overrides": {
    "@types/minimatch": "5.1.2"
  },
  "scripts": {
    "build": "node scripts/check-tokens.js && ojet build",
    "build:release": "node scripts/check-tokens.js && ojet build --release && node scripts/build-previews.js",
    "serve": "ojet serve",
    "build:previews": "node scripts/build-previews.js",
    "check:tokens": "node scripts/check-tokens.js",
    "check:responsive": "node scripts/check-responsive.js",
    "check:interactions": "node scripts/check-interactions.js"
  }
}
