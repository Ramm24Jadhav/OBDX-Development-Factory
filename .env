# Settings for docker compose (docker-compose.yml). Change them here, then: docker compose up -d
# These defaults are for development and trials on a machine your team controls, with the demo code.

# Which optional parts run: "model" (local Ollama model server) and "demo" (demo SVN server and workspaces).
# Remove "model" to use a model server you already have (set FACTORY_MODEL_BASE_URL below).
COMPOSE_PROFILES=model,demo

# Port the factory is opened on: http://<this machine>:8080/
FACTORY_HTTP_PORT=8080

# Password of the "admin" account, set on the first start only (at least 12 characters). Change it before the first
# start; afterwards change it in the factory (Profile menu), and update it here too for the demo setup.
FACTORY_ADMIN_PASSWORD=Factory-Admin-1

# Database password (the database is only reachable by the factory container).
DB_PASSWORD=factory

# Encrypts stored SVN passwords. Empty: generated on the first start and kept in the factory-data volume.
FACTORY_SECRET_KEY=

# Model server: the bundled Ollama by default. For another one, for example vLLM or Ollama on a GPU machine:
# FACTORY_MODEL_BASE_URL=http://gpu-host:11434/v1
FACTORY_MODEL_BASE_URL=http://ollama:11434/v1
FACTORY_MODEL_CHAT=qwen2.5-coder:7b
FACTORY_MODEL_EMBEDDING=nomic-embed-text
# Proxy for downloading the models on the first start, if the machine has no direct internet access.
MODEL_DOWNLOAD_PROXY=
# Answers from a model on a CPU are slow; allow them time.
FACTORY_MODEL_TIMEOUT=300s

# Demo SVN server: port and the account the factory commits change branches with.
SVN_PORT=3690
SVN_USER=factory
SVN_PASSWORD=factory-demo

# Memory for the factory's Java process, as a share of what the container may use.
FACTORY_JAVA_OPTS=-XX:MaxRAMPercentage=75
