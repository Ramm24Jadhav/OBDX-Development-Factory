# Settings for OBDX Development Factory. Keep this file readable only by the service user (chmod 600).
FACTORY_PORT=8080

FACTORY_DB_URL=jdbc:postgresql://localhost:5432/factory
FACTORY_DB_USER=factory
FACTORY_DB_PASSWORD=change-me

# How people sign in: local (accounts in the factory), ldap (bank directory) or oidc (single sign-on).
FACTORY_AUTH_MODE=local
# Password of the first "admin" account in local mode. If empty, a random one is written to the log once.
FACTORY_ADMIN_PASSWORD=
# Comma-separated usernames that are always administrators (useful for ldap and oidc).
FACTORY_ADMIN_USERS=
# Signed-in sessions end after this much inactivity. Set FACTORY_COOKIE_SECURE=true when served over HTTPS.
FACTORY_SESSION_TIMEOUT=30m
FACTORY_COOKIE_SECURE=false

# LDAP / Active Directory (FACTORY_AUTH_MODE=ldap)
FACTORY_LDAP_URL=ldaps://ad.bank.local:636
FACTORY_LDAP_USER_SEARCH_BASE=ou=Users,dc=bank,dc=local
FACTORY_LDAP_USER_SEARCH_FILTER=(sAMAccountName={0})
FACTORY_LDAP_MANAGER_DN=
FACTORY_LDAP_MANAGER_PASSWORD=

# Single sign-on (FACTORY_AUTH_MODE=oidc): register the factory with the identity provider
# (redirect URI https://<factory host>/login/oauth2/code/sso) and set the standard Spring settings, for example:
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_SSO_CLIENT_ID=obdx-factory
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_SSO_CLIENT_SECRET=...
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_SSO_SCOPE=openid,profile,email
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_SSO_ISSUER_URI=https://login.microsoftonline.com/<tenant>/v2.0
FACTORY_OIDC_USERNAME_CLAIM=preferred_username

# Where generated changes are committed as branches, relative to the SVN repository root.
FACTORY_CHANGE_BRANCH_FOLDER=branches/factory

# Encrypts stored SVN passwords. Generate once with: openssl rand -base64 32
# Keep it secret and never change it, or stored passwords can no longer be read.
FACTORY_SECRET_KEY=

# Where the factory keeps each workspace's SVN working copy. Needs room for the bank codebases.
FACTORY_DATA_DIR=/var/lib/obdx-factory

# Set to true only if the SVN server's certificate is signed by an internal CA that is not in the system trust store.
FACTORY_SVN_TRUST_UNKNOWN_CA=false

# OpenAI-compatible model endpoint: Ollama (http://host:11434/v1), vLLM (http://host:8000/v1) or a private cloud endpoint.
FACTORY_MODEL_BASE_URL=http://localhost:11434/v1
FACTORY_MODEL_API_KEY=not-needed
FACTORY_MODEL_CHAT=qwen2.5-coder:7b
FACTORY_MODEL_EMBEDDING=nomic-embed-text
FACTORY_MODEL_TIMEOUT=120s
