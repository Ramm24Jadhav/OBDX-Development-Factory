<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>

  <groupId>com.obdx.factory</groupId>
  <artifactId>obdx-development-factory</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>OBDX Development Factory</name>

  <modules>
    <module>factory-ui</module>
    <module>factory-server</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <langchain4j.version>1.22.0</langchain4j.version>
    <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
    <!-- Node.js used to build the Oracle JET UI. Point node.download.root at an internal mirror for offline builds. -->
    <node.version>v22.22.0</node.version>
    <node.download.root>https://nodejs.org/dist/</node.download.root>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.obdx.factory</groupId>
        <artifactId>factory-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.langchain4j</groupId>
        <artifactId>langchain4j-open-ai</artifactId>
        <version>${langchain4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
