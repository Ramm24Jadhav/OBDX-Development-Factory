{
  "$comment": "The motion spec: what each component does on enter, hover, press, a value change, open and close, an error and while loading, the same in every pack. 'style' follows the component style saved in the Component factory (bx-motion-hover-lift|glow|shine, bx-motion-click-press|ripple|bounce, bx-motion-scroll-fadeup|scale|slide|blur); the other names are in effects. Durations and easing are the --bx-dur-* and --bx-ease-* tokens. Under reduced motion every component shows its end state. packs says where the motion is built.",
  "version": 1,
  "effects": {
    "style": "Follows the component style (hover, click or scroll effect chosen in the Component factory)",
    "border": "The border takes the brand colour on hover",
    "tint": "A row or item takes a light tint on hover",
    "shake": "The field shakes once when its error appears",
    "shimmer": "A light sweeps across while it loads",
    "spin": "Turns while it waits",
    "roll": "A changed number rolls up into place",
    "pop": "A chosen mark, chip or code slot pops",
    "spring": "Opens and closes on a spring; the switch knob springs across",
    "slide": "The chosen tab, step or segment slides into place",
    "settle": "New rows and files settle in from above",
    "grow": "Bars and meters grow to their value",
    "drop": "A list or menu drops down from its field",
    "fade": "Fades in",
    "rise": "Rises and fades in",
    "slide-down": "Slides down into place",
    "effect": "The component is the effect itself (text, motion, backdrop and micro interaction categories)"
  },
