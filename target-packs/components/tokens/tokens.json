{
  "$description": "The bank design tokens every premium pack reads. Values are a neutral bank brand; a workspace overrides them with the bank's own. Format follows the Design Tokens Community Group draft ($value, $type) so Style Dictionary can read it too. Build with: node build-tokens.js",
  "color": {
    "$type": "color",
    "primary": { "$value": "#0b5fa5", "$description": "Filled primary buttons, selected states, focus ring" },
    "primary-hover": { "$value": "#094f8a" },
    "primary-active": { "$value": "#073f6e" },
    "primary-text": { "$value": "#0a5594", "$description": "Links and primary-coloured text on surfaces" },
    "primary-soft": { "$value": "#e8f1fa", "$description": "Selected rows, chips, info tints" },
    "on-primary": { "$value": "#ffffff" },
    "bg": { "$value": "#f6f8fa" },
    "surface": { "$value": "#ffffff" },
    "surface-2": { "$value": "#f4f6f8" },
    "surface-3": { "$value": "#e9edf1" },
    "border": { "$value": "#dbe1e7" },
    "border-strong": { "$value": "#aab4bf", "$description": "Field borders (3:1 against surface)" },
    "text": { "$value": "#1f2933" },
    "text-body": { "$value": "#34404c" },
    "text-muted": { "$value": "#5f6b7a" },
    "success": { "$value": "#12805c" },
    "success-text": { "$value": "#0d6b4c" },
    "success-soft": { "$value": "#e7f6ef" },
    "warning": { "$value": "#d97706" },
    "warning-text": { "$value": "#92400e" },
    "warning-soft": { "$value": "#fff6e5" },
    "danger": { "$value": "#c62828" },
    "danger-text": { "$value": "#b42318" },
    "danger-soft": { "$value": "#fdecec" },
    "info": { "$value": "#0277bd" },
    "info-text": { "$value": "#01579b" },
    "info-soft": { "$value": "#e6f4fb" },
    "overlay": { "$value": "rgba(15, 23, 42, 0.45)" }
  },
  "dark": {
    "$description": "Dark theme: only the colours change.",
    "color": {
      "$type": "color",
      "primary": { "$value": "#3b8fd6" },
      "primary-hover": { "$value": "#5aa3e0" },
      "primary-active": { "$value": "#2c7cc0" },
      "primary-text": { "$value": "#8cc3f2" },
      "primary-soft": { "$value": "rgba(59, 143, 214, 0.18)" },
      "on-primary": { "$value": "#0b1724" },
      "bg": { "$value": "#0d1520" },
      "surface": { "$value": "#141e2b" },
      "surface-2": { "$value": "#1a2635" },
      "surface-3": { "$value": "#223143" },
      "border": { "$value": "#2a3a4e" },
      "border-strong": { "$value": "#5c6f86" },
      "text": { "$value": "#e8edf2" },
      "text-body": { "$value": "#c9d2dc" },
      "text-muted": { "$value": "#9aa8b7" },
      "success": { "$value": "#34c08f" },
      "success-text": { "$value": "#5fd6a9" },
      "success-soft": { "$value": "rgba(52, 192, 143, 0.15)" },
      "warning": { "$value": "#f5a524" },
      "warning-text": { "$value": "#f8c060" },
      "warning-soft": { "$value": "rgba(245, 165, 36, 0.15)" },
      "danger": { "$value": "#ef5350" },
      "danger-text": { "$value": "#f48a88" },
      "danger-soft": { "$value": "rgba(239, 83, 80, 0.15)" },
      "info": { "$value": "#29a3e0" },
      "info-text": { "$value": "#7cc8ef" },
      "info-soft": { "$value": "rgba(41, 163, 224, 0.15)" },
      "overlay": { "$value": "rgba(0, 0, 0, 0.6)" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Inter, 'Segoe UI', system-ui, sans-serif" },
    "family-mono": { "$type": "fontFamily", "$value": "'Cascadia Mono', Consolas, monospace" },
    "size-xs": { "$type": "dimension", "$value": "12px" },
    "size-s": { "$type": "dimension", "$value": "13px" },
    "size-m": { "$type": "dimension", "$value": "14px" },
    "size-l": { "$type": "dimension", "$value": "16px" },
    "size-xl": { "$type": "dimension", "$value": "20px" },
    "size-xxl": { "$type": "dimension", "$value": "26px" },
    "weight-regular": { "$type": "fontWeight", "$value": 400 },
    "weight-medium": { "$type": "fontWeight", "$value": 500 },
    "weight-bold": { "$type": "fontWeight", "$value": 700 }
  },
  "space": {
    "$type": "dimension",
    "xxs": { "$value": "2px" },
    "xs": { "$value": "4px" },
    "s": { "$value": "8px" },
    "m": { "$value": "12px" },
    "l": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "xxl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": "4px" },
    "m": { "$value": "8px" },
    "l": { "$value": "12px" },
    "pill": { "$value": "999px" }
  },
  "control": {
    "$type": "dimension",
    "height-s": { "$value": "32px" },
    "height-m": { "$value": "40px" },
    "height-l": { "$value": "48px", "$description": "Touch targets on mobile" },
    "focus-ring": { "$value": "3px" }
  },
  "shadow": {
    "$type": "shadow",
    "s": { "$value": "0 1px 2px rgba(15, 23, 42, 0.08)" },
    "m": { "$value": "0 4px 12px rgba(15, 23, 42, 0.12)" },
    "l": { "$value": "0 12px 32px rgba(15, 23, 42, 0.18)" }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": "120ms" },
    "duration-base": { "$type": "duration", "$value": "200ms" },
    "duration-slow": { "$type": "duration", "$value": "320ms" },
    "ease-standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "ease-exit": { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "breakpoint": {
    "$type": "dimension",
    "phone": { "$value": "0px" },
    "tablet": { "$value": "768px" },
    "laptop": { "$value": "1024px" },
    "desktop": { "$value": "1440px" }
  }
}
